{
  "name": "bcoffense",
  "version": "1.0.0",
  "private": true,
  "description": "BCOffense app shell and root test command shortcuts",
  "scripts": {
    "test:unit": "node tests/threads.test.mjs && node tests/reactions.test.mjs && node tests/moderation.test.mjs && node tests/questions.test.mjs && node tests/likes.test.mjs && node tests/reply-composer.test.mjs",
    "test:quality": "node scripts/smoke-check.js && npm run test:unit && npm run test:e2e:local:hydration",
    "audit:globals": "node scripts/global-contract-audit.mjs --strict",
    "stress:audit": "node scripts/stress-seed-audit.mjs",
    "stress:script-perf": "node scripts/stress-seed-audit.mjs --script-perf --roles=admin --tabs=script --viewports=1280x800 --plays=900 --scripts=35 --script-plays=96 --warn-only",
    "test:e2e": "npm --prefix tests test",
    "test:e2e:local": "npm --prefix tests run test:local",
    "test:e2e:local:phone": "npm --prefix tests run test:local:phone",
    "test:e2e:local:ipad": "npm --prefix tests run test:local:ipad",
    "test:e2e:local:all": "npm --prefix tests run test:local:all",
    "test:e2e:local:hydration": "npm --prefix tests run test:local:hydration",
    "test:e2e:all": "npm --prefix tests run test:all",
    "test:e2e:phone": "npm --prefix tests run test:phone",
    "test:e2e:ipad": "npm --prefix tests run test:ipad",
    "test:e2e:headers": "npm --prefix tests run test:headers",
    "test:e2e:screenshots": "npm --prefix tests run screenshots",
    "playwright": "cd tests && npm exec -- playwright"
  }
}

{
  "name": "bcoffense-tests",
  "version": "1.0.0",
  "description": "Playwright E2E tests for BCOffense — isolated from app, no build tools",
  "private": true,
  "scripts": {
    "test":        "playwright test --project=chromium-desktop",
    "test:local":  "BCOFFENSE_E2E_LOCAL=1 playwright test --project=chromium-desktop",
    "test:local:phone": "BCOFFENSE_E2E_LOCAL=1 playwright test --project=iphone --project=phone-narrow",
    "test:local:ipad":  "BCOFFENSE_E2E_LOCAL=1 playwright test --project=ipad-portrait --project=ipad-landscape",
    "test:local:webkit-ipad-smoke": "node run-local-webkit-ipad-smoke.mjs",
    "test:local:all":   "BCOFFENSE_E2E_LOCAL=1 playwright test --project=chromium-desktop --project=ipad-portrait --project=ipad-landscape --project=iphone --project=phone-narrow",
    "test:local:hydration": "node run-local-hydration.mjs",
    "test:all":    "playwright test",
    "test:ipad":   "playwright test --project=ipad-portrait --project=ipad-landscape",
    "test:phone":  "playwright test --project=iphone --project=phone-narrow",
    "test:headed": "playwright test --project=chromium-desktop --headed",
    "screenshots": "playwright test --project=chromium-desktop --grep @screenshots",
    "test:headers": "playwright test --project=chromium-desktop specs/06-headers-toolbars.spec.js",
    "report":      "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0"
  }
}
